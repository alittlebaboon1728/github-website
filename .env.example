# Optional: public repositories also have cached/public-page fallbacks without a token.
# A server-side token increases GitHub REST quota; never set VITE_GITHUB_TOKEN.
# Copy to .env.local and restart the server to use your GitHub token.
GITHUB_TOKEN=
PORT=4173
# Listen on local network interfaces; set 127.0.0.1 for localhost only.
HOST=0.0.0.0

# Optional server-side model. All three fields are required; no browser VITE_* keys.
# Any compatible Chat Completions endpoint with JSON object output; base URL ends in /v1.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# DeepSeek example: https://api.deepseek.com/v1 and deepseek-flash.
AI_THINKING=disabled

# Separate model for project trials. Local api.txt may provide a "gpt:" key.
TRIAL_AI_BASE_URL=https://api.openai.com/v1
TRIAL_AI_API_KEY=
TRIAL_AI_MODEL=gpt-6.1-sol

# Local default .data; production: an absolute path on a persistent volume, one Node process.
OBSERVATORY_DATA_DIR=.data
# Set to off to disable disk persistence (growth then unavailable).
OBSERVATORY_PERSISTENCE=on
# Production only: collect the default top-stars cohort every 6 hours.
# Alternatively schedule npm run collect; filtered cohorts collect when visited.
OBSERVATORY_COLLECT=off
