{
  "name": "github-workspace-redesign",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "predev": "node scripts/copy-editor-assets.mjs",
    "prebuild": "node scripts/copy-editor-assets.mjs",
    "start": "node --env-file-if-exists=.env.local server/index.mjs",
    "lan:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/lan.ps1 -Action Start",
    "lan:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/lan.ps1 -Action Stop",
    "lan:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/lan.ps1 -Action Status",
    "test:server": "node --test tests/*.test.mjs",
    "collect": "node --env-file-if-exists=.env.local scripts/collect.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "^3.3.20"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "^5.1.16"
    },
    "lodash-es": "^4.18.1",
    "katex": "^0.18.2"
  }
}
